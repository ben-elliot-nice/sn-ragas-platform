# Inbound auth: Cognigy's HTTP Request node sends this back as X-API-Key.
API_KEY=replace-me

# Direct OpenAI API (not Azure OpenAI, since hosting moved to Railway).
OPENAI_API_KEY=sk-replace-me
JUDGE_MODEL=gpt-4.1
EMBEDDING_MODEL=text-embedding-3-small

# Golden set is bundled at service/data/golden_set.json by default — only
# set these if you need to point somewhere else.
# GOLDEN_SET_PATH=data/golden_set.json
# GOLDEN_SET_EMBEDDINGS_PATH=data/golden_set.embeddings.json

MATCH_CONFIDENCE_FLOOR=0.7
THRESHOLDS={}
LOG_DESTINATION=local:./eval_log.jsonl
